# FUTURESCOUT AI - environment variables
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit ".env". Only this ".env.example" belongs in git.

# ---------------------------------------------------------------
# NEAR AI Cloud (all agents use models from here)  [Phase 0/1]
# Get a key at https://cloud.near.ai (API keys section)
# ---------------------------------------------------------------
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# ---------------------------------------------------------------
# OpenAlex (academic papers)  [Phase 1]
# Keys are mandatory since 2026-02-13. Free account -> https://openalex.org/settings/api
# Without a key you only get a tiny daily test allowance.
# ---------------------------------------------------------------
OPENALEX_API_KEY=

# SEC EDGAR needs no key, but the SEC requires a User-Agent that identifies you, with a
# contact email (it is sent only to sec.gov). Example: EDGAR_USER_AGENT=YourName you@example.com
EDGAR_USER_AGENT=

# arXiv needs no key. Limit: 1 request / 3 seconds (enforced in code).

# Identifies this tool to public APIs. Do not put personal data here.
HTTP_USER_AGENT=FuturescoutAI/0.1 (research prototype)

# ---------------------------------------------------------------
# PostgreSQL (stores every research run: sources, findings, report, usage)  [Phase 8]
# Leave empty to skip the database; reports are still written to backend/runs/.
# Format: postgresql://USER:PASSWORD@localhost:5432/DATABASE
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Price & timing risk (Risk agent): Alpha Vantage free key, instant at
# https://www.alphavantage.co/support/#api-key . Free plan: 25 requests/day, last 100 trading days.
# Prices are cached 12 h in backend/cache/prices/. Leave empty to skip the price check.
# ---------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------
# Patent agent, option 1: Google Patents via SerpApi (https://serpapi.com/manage-api-key).
# Each request = 1 search of your plan; one research run uses at most 6; repeats within 24 h are
# served from backend/cache/ for free. Used first if set.
# ---------------------------------------------------------------
SERPAPI_API_KEY=

# ---------------------------------------------------------------
# Patent agent, option 2: EPO Open Patent Services. Free registration at https://developers.epo.org
# (create an app with OPS enabled). Free up to 4 GB per week. Leave empty to skip patents.
# ---------------------------------------------------------------
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# ---------------------------------------------------------------
# X API (read-only; pay-per-use: ~$0.005 per post read, ~$0.010 per account lookup)
# Bearer token from developer.x.com -> your app -> Keys and tokens. Leave empty to skip the X agent.
# Only accounts approved in backend/config/x_watchlist.yaml are ever searched.
# ---------------------------------------------------------------
X_BEARER_TOKEN=

# ---------------------------------------------------------------
# NEAR TESTNET record of report fingerprints (SHA-256) in SocialDB (v1.social08.testnet).
# Use a DEDICATED testnet account holding only free testnet NEAR. Mainnet accounts are refused in code.
# The agents never get this key: it is used only to store a report's fingerprint after the run.
# ---------------------------------------------------------------
NEAR_TESTNET_ACCOUNT_ID=
NEAR_TESTNET_PRIVATE_KEY=


# ---------------------------------------------------------------
# Dashboard API (python scripts\serve.py)
# Starting a research run from the dashboard spends NEAR AI credit (~$0.17 per run, measured).
# Leave false to only browse saved reports; set true to enable the "Start research" button.
# ---------------------------------------------------------------
ENABLE_RUN_API=false

# ---------------------------------------------------------------
# Later phases (not used yet; listed so you know what is coming)
# ---------------------------------------------------------------

# Watch mode (scripts/watch.py): scan cadence and spending caps.
WATCH_X_INTERVAL_MINUTES=120
WATCH_MAX_RUNS_PER_DAY=2
WATCH_REPORT_MAX_AGE_DAYS=7
WATCH_HEAT_THRESHOLD=40
WATCH_X_MENTIONS_THRESHOLD=3
WATCH_NEW_PATENT_TOPICS_PER_WEEK=2

# Set true before a demo to spend NO SerpApi searches: cached patent data (any age) is served, uncached topics say 'paused'.
SERPAPI_CACHE_ONLY=false

# ---------------------------------------------------------------
# Paper portfolio: a SIMULATION (no money moves). Each sealed report "buys" its top Company Scout
# candidates with a pretend notional at the first close on/after the report date; priced with the
# Alpha Vantage key above by `python scripts\portfolio.py` (free plan: 25 requests/day).
# ---------------------------------------------------------------
PORTFOLIO_NOTIONAL_USD=10000
PORTFOLIO_POSITIONS_PER_REPORT=3
PORTFOLIO_BENCHMARK=SOXX
PORTFOLIO_MAX_PRICE_REQUESTS=20

# Paper scout: every N days the watcher looks for new fast-growing topics per sector in recent paper keywords (0 = off)
WATCH_PAPER_DISCOVERY_DAYS=7

# ---------------------------------------------------------------
# X reading in watch mode (each post read costs about $0.005, each profile lookup about $0.01).
# The agent grows its read list by itself: verified accounts only, score >= 8 with real substance
# (2+ topic posts, a senior role, or @mentions by watched accounts). It never follows anyone on X.
# ---------------------------------------------------------------
WATCH_X_MAX_POSTS=100
WATCH_X_DAILY_BUDGET_USD=3.0
WATCH_X_DISCOVERY_TOPICS_PER_DAY=3
WATCH_X_ENDORSE_LOOKUPS_PER_SCAN=10

# Stage 3 live-trading test (see STAGE3_PLAN.md). A NEW mainnet account used for nothing else, holding only the
# small test budget. Type the key yourself; never paste it in chat. Leave empty to keep live trading impossible.
# (The on/off switch is NOT here: it is `trading_enabled` in backend/config/funds.yaml.)
FUND_MAINNET_ACCOUNT_ID=
FUND_MAINNET_PRIVATE_KEY=
# Agent economy: the report agent sells reports to the trading agent and stakes its NEAR for NEAR AI credits (mainnet)
REPORT_AGENT_ACCOUNT_ID=
REPORT_AGENT_PRIVATE_KEY=
# Optional: NEAR Intents partner API key (https://partners.near-intents.org) to avoid the extra 0.25% fee.
ONECLICK_API_KEY=
